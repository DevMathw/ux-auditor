# Copy this file to .env.local. Every variable here is optional:
# with none of them set, the app still returns a complete deterministic audit.
# NEVER put a real key in this file — it is committed.

# Enables the AI interpretation layer. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public origin. Used for canonical URLs, sitemap and OpenGraph images.
# On Vercel this is derived from VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=https://ux-auditor-chi.vercel.app

# ── Rendering layer (optional) ───────────────────────────────────────────────
# Pick ONE. Without any of them the app looks for an installed Chrome or Edge,
# and if it finds none the 5 visual rules are skipped. Check /api/health to see
# which provider actually resolved.

# Recommended for serverless: a hosted browser reached over CDP.
# BROWSER_WS_ENDPOINT=wss://your-browser-host

# Or point directly at a Chromium binary.
# PLAYWRIGHT_EXECUTABLE_PATH=/path/to/chromium

# Only where the host cannot support Chrome's sandbox (Lambda, some containers).
# The sandbox is the main defence while running third-party JavaScript, so this
# should stay unset anywhere it can.
# PLAYWRIGHT_NO_SANDBOX=1

# ── Métricas de coste (opcional) ─────────────────────────────────────────────
# Protege GET /api/usage, que expone tokens consumidos y coste acumulado.
# Sin esta variable el endpoint devuelve 404: mejor no existir que estar
# abierto por olvido.
# USAGE_TOKEN=
